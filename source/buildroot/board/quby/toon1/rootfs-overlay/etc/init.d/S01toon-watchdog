#!/bin/sh
# Hardware watchdog (i.MX27 WDOG, kernel driver imx2_wdt). If the system
# hangs, the SoC resets itself instead of staying dead until someone pulls
# the plug. The busybox daemon pets the watchdog every 10 s; the hardware
# resets after 60 s without a pet. Started first (S01) so the window without
# a pet is as short as possible. Once started the i.MX watchdog cannot be
# switched off; if the daemon ever exits, the kernel keeps it fed itself.
# The WDOG is picked by its device node (10002000.watchdog), as on the Toon 2.
find_wdog() {
	for w in /sys/class/watchdog/watchdog*; do
		case "$(readlink -f $w/device 2>/dev/null)" in
		*10002000.watchdog) echo /dev/$(basename $w); return 0 ;;
		esac
	done
	return 1
}

case "$1" in
  start)
	dev=$(find_wdog) || { echo "toon-watchdog: i.MX WDOG not found"; exit 0; }
	watchdog -T 60 -t 10 $dev && echo "toon-watchdog: 60 s hardware watchdog running on $dev"
	;;
  stop)
	# leaves the watchdog running in the kernel (cannot be stopped anyway)
	killall watchdog 2>/dev/null
	;;
  restart)
	$0 stop; $0 start
	;;
esac
exit 0
