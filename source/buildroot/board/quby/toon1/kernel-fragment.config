# Toon 1 (i.MX27) on top of imx_v4_v5_defconfig

# Old U-Boot 2010.09 has no device tree support: the DTB is appended to the
# kernel. Memory and command line come from the device tree only; the ATAGs
# (the original command line with ubi.mtd=4 and a read-only u-boot-env) are ignored.
CONFIG_ARM_APPENDED_DTB=y
# CONFIG_ARM_ATAG_DTB_COMPAT is not set

# I2C (not in imx_v4_v5_defconfig): touch, sensors, RTC and codec are on it
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_IMX=y

# Display, backlight, touch
CONFIG_FB=y
CONFIG_FB_IMX=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_TSC2007=y
# CONFIG_LOGO is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set

# Sensors and clock
CONFIG_HWMON=y
CONFIG_SENSORS_ADT7410=y
CONFIG_SENSORS_TMP401=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_ISL1208=y

# USB host (ULPI) and the WiFi dongle: the Toon 1 came with a Ralink RT5370
# a Marvell 88W8801 or a Realtek RTL8191SU (r92su, a package of its own:
# out of the kernel tree)
CONFIG_USB_ULPI=y
CONFIG_USB_ULPI_VIEWPORT=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN=y
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT53XX=y
CONFIG_WLAN_VENDOR_MARVELL=y
CONFIG_MWIFIEX=m
CONFIG_MWIFIEX_USB=m
CONFIG_FW_LOADER=y

# Ethernet (needed for the network boot)
CONFIG_NETDEVICES=y
CONFIG_FEC=y

# Storage: the original UBI/UBIFS, our squashfs on a loop device
CONFIG_MTD=y
CONFIG_MTD_UBI=y
CONFIG_UBIFS_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_BLK_DEV_LOOP=y

# Userland bits ReToon uses
CONFIG_GPIO_CDEV=y
CONFIG_LEDS_CLASS=y
CONFIG_TMPFS=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_IPV6=m

# --- Size: the kernel must stay below U-Boot's splash buffer (0xa1400000)
# while it unpacks, and later fit the 3 MiB kernel partition. Off: what the
# Toon 1 does not have, and debug features.
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_RD_XZ=y
# CONFIG_SOC_IMX1 is not set
# CONFIG_SOC_IMX25 is not set
# CONFIG_ARCH_MULTI_V4T is not set
# CONFIG_PM_DEBUG is not set
# CONFIG_KPROBES is not set
# CONFIG_PROFILING is not set
# CONFIG_FTRACE is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_NETFILTER is not set
# CONFIG_IMX_WEIM is not set
# CONFIG_MTD_CFI is not set
# CONFIG_MTD_PHYSMAP is not set
# CONFIG_EEPROM_AT24 is not set
# CONFIG_EEPROM_AT25 is not set
# CONFIG_ATA is not set
# CONFIG_SCSI is not set
# CONFIG_CS89x0 is not set
# CONFIG_DM9000 is not set
# CONFIG_SMC91X is not set
# CONFIG_SMC911X is not set
# CONFIG_SMSC911X is not set
# CONFIG_KEYBOARD_GPIO is not set
# CONFIG_KEYBOARD_IMX is not set
# CONFIG_TOUCHSCREEN_ADS7846 is not set
# CONFIG_TOUCHSCREEN_MX25 is not set
# CONFIG_TOUCHSCREEN_MC13783 is not set
# CONFIG_SERIAL_8250 is not set
# CONFIG_SPI is not set
# CONFIG_W1 is not set
# CONFIG_MFD_MC13XXX_SPI is not set
# CONFIG_MFD_MX25_TSADC is not set
# CONFIG_REGULATOR_GPIO is not set
# CONFIG_REGULATOR_MC13783 is not set
# CONFIG_REGULATOR_MC13892 is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_LCD_L4F00242T03 is not set
CONFIG_SOUND=m
# CONFIG_USB_HID is not set
# CONFIG_USB_STORAGE is not set
# CONFIG_USB_CHIPIDEA_UDC is not set
# CONFIG_USB_GADGET is not set
# CONFIG_MMC is not set
# CONFIG_LEDS_MC13783 is not set
# CONFIG_RTC_DRV_PCF8563 is not set
# CONFIG_RTC_DRV_IMXDI is not set
# CONFIG_RTC_DRV_MXC is not set
# CONFIG_IIO is not set
# CONFIG_PWM_IMX1 is not set
# CONFIG_EXT4_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_JFFS2_FS is not set
# CONFIG_FONTS is not set
# Not needed to boot: modules, loaded by S02toon-modules
CONFIG_NFS_FS=m
# CONFIG_ROOT_NFS is not set
# CONFIG_IO_URING is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_PERF_EVENTS is not set

# root image on the original UBIFS, RAM layer on top
CONFIG_OVERLAY_FS=y
# overlayfs copy-up needs xattrs on the RAM layer (else: Input/output error)
CONFIG_TMPFS_XATTR=y

# Size: kernel + boot manager must fit next to the original kernel (2026-10-18)
# CONFIG_KALLSYMS is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_DEBUG_MISC is not set
# CONFIG_SYMBOLIC_ERRNAME is not set
# CONFIG_FTRACE is not set
# CONFIG_NET_VENDOR_CIRRUS is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_SERIO is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_PTP_1588_CLOCK is not set
# CONFIG_PPS is not set
# CONFIG_CGROUPS is not set
# CONFIG_AUDIT is not set
# CONFIG_KEYS is not set
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
# CONFIG_UBIFS_FS_ZSTD is not set
# CONFIG_MTD_BLOCK is not set
# CONFIG_CRC32_SLICEBY8 is not set
CONFIG_CRC32_SARWATE=y
# CONFIG_XZ_DEC_X86 is not set
# CONFIG_XZ_DEC_POWERPC is not set
# CONFIG_XZ_DEC_ARM64 is not set
# CONFIG_XZ_DEC_SPARC is not set
# CONFIG_XZ_DEC_RISCV is not set
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS is not set
CONFIG_UBIFS_FS_ADVANCED_COMPR=y
CONFIG_UBIFS_FS_LZO=y
CONFIG_UBIFS_FS_ZLIB=y
# The Toon's U-Boot command line (ubi.mtd=4, mtdparts=...ro) must not count:
# only the device tree's bootargs and partitions do.
# CONFIG_MTD_CMDLINE_PARTS is not set
# a ramdisk is only ever xz (network boot); no ip= autoconfiguration
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
# CONFIG_IP_PNP is not set
# Audio: TLV320AIC3111 on SSI1 via the audio mux, all as modules for now
CONFIG_SND=m
CONFIG_SND_SOC=m
CONFIG_SND_IMX_SOC=m
CONFIG_SND_SOC_FSL_SSI=m
CONFIG_SND_SOC_IMX_AUDMUX=m
CONFIG_SND_SOC_TLV320AIC31XX=m
CONFIG_SND_SIMPLE_CARD=m
CONFIG_COMMON_CLK_TOON1_MCLK=m
# the USB port: memory sticks (FAT) and USB-serial sticks (Zigbee/Z-Wave
# radios), as modules; loaded at the start by S02toon-modules
CONFIG_SCSI=m
CONFIG_BLK_DEV_SD=m
CONFIG_USB_STORAGE=m
CONFIG_FAT_FS=m
CONFIG_VFAT_FS=m
CONFIG_EXFAT_FS=m
CONFIG_NLS_UTF8=m
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_CH341=m
