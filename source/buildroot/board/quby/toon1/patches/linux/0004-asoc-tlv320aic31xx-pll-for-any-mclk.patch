From: ReToon
Subject: [PATCH] ASoC: tlv320aic31xx: compute the PLL for an MCLK not in the table

The Toon 1 feeds its TLV320AIC3111 an 11.77 MHz master clock (GPT1
TOUT, PERCLK1/2). For an MCLK between 10 and 20 MHz that is not in
aic31xx_divs, take the dividers of a row for the sample rate and
compute the fractional PLL multiplier J.D (R = 1).
---
--- a/sound/soc/codecs/tlv320aic31xx.c	2026-10-25 08:53:36.386628179 +0000
+++ b/sound/soc/codecs/tlv320aic31xx.c	2026-10-25 09:28:52.951943730 +0000
@@ -863,6 +863,8 @@
 	int bclk_n = 0;
 	int match = -1;
 	int i;
+	struct aic31xx_rate_divs calc;
+	const struct aic31xx_rate_divs *div = NULL;
 
 	if (!aic31xx->sysclk || !aic31xx->p_div) {
 		dev_err(component->dev, "Master clock not supplied\n");
@@ -892,6 +894,45 @@
 	}
 
 	if (match == -1) {
+		/*
+		 * MCLK not in the table (the Toon 1 has 11.77 MHz): take the
+		 * dividers of a row for this rate and compute the fractional
+		 * PLL multiplier J.D for this MCLK (R = 1).
+		 */
+		for (i = 0; i < ARRAY_SIZE(aic31xx_divs); i++) {
+			int s, bn;
+
+			if (aic31xx_divs[i].rate != params_rate(params))
+				continue;
+			s = (aic31xx_divs[i].dosr * aic31xx_divs[i].mdac) %
+				snd_soc_params_to_frame_size(params);
+			bn = (aic31xx_divs[i].dosr * aic31xx_divs[i].mdac) /
+				snd_soc_params_to_frame_size(params);
+			if (s < bclk_score && bn > 0) {
+				match = i;
+				bclk_n = bn;
+				bclk_score = s;
+			}
+		}
+		if (match != -1) {
+			u64 clkin = (u64)params_rate(params) * aic31xx_divs[match].dosr *
+				    aic31xx_divs[match].ndac * aic31xx_divs[match].mdac;
+			u64 jd = div_u64(clkin * 10000 + mclk_p / 2, mclk_p);
+
+			calc = aic31xx_divs[match];
+			calc.mclk_p = mclk_p;
+			calc.pll_r = 1;
+			calc.pll_j = div_u64(jd, 10000);
+			calc.pll_d = jd - (u64)calc.pll_j * 10000;
+			if (mclk_p < 10000000 || mclk_p > 20000000 ||
+			    calc.pll_j < 4 || calc.pll_j > 11 ||
+			    clkin < 80000000 || clkin > 110000000)
+				match = -1;
+			else
+				div = &calc;
+		}
+	}
+	if (match == -1) {
 		dev_err(component->dev,
 			"%s: Sample rate (%u) and format not supported\n",
 			__func__, params_rate(params));
@@ -909,33 +950,35 @@
 		*/
 	}
 	i = match;
+	if (div != &calc)
+		div = &aic31xx_divs[i];
 
 	/* PLL configuration */
 	snd_soc_component_update_bits(component, AIC31XX_PLLPR, AIC31XX_PLL_MASK,
-			    (aic31xx->p_div << 4) | aic31xx_divs[i].pll_r);
-	snd_soc_component_write(component, AIC31XX_PLLJ, aic31xx_divs[i].pll_j);
+			    (aic31xx->p_div << 4) | div->pll_r);
+	snd_soc_component_write(component, AIC31XX_PLLJ, div->pll_j);
 
 	snd_soc_component_write(component, AIC31XX_PLLDMSB,
-		      aic31xx_divs[i].pll_d >> 8);
+		      div->pll_d >> 8);
 	snd_soc_component_write(component, AIC31XX_PLLDLSB,
-		      aic31xx_divs[i].pll_d & 0xff);
+		      div->pll_d & 0xff);
 
 	/* DAC dividers configuration */
 	snd_soc_component_update_bits(component, AIC31XX_NDAC, AIC31XX_PLL_MASK,
-			    aic31xx_divs[i].ndac);
+			    div->ndac);
 	snd_soc_component_update_bits(component, AIC31XX_MDAC, AIC31XX_PLL_MASK,
-			    aic31xx_divs[i].mdac);
+			    div->mdac);
 
-	snd_soc_component_write(component, AIC31XX_DOSRMSB, aic31xx_divs[i].dosr >> 8);
-	snd_soc_component_write(component, AIC31XX_DOSRLSB, aic31xx_divs[i].dosr & 0xff);
+	snd_soc_component_write(component, AIC31XX_DOSRMSB, div->dosr >> 8);
+	snd_soc_component_write(component, AIC31XX_DOSRLSB, div->dosr & 0xff);
 
 	/* ADC dividers configuration. Write reset value 1 if not used. */
 	snd_soc_component_update_bits(component, AIC31XX_NADC, AIC31XX_PLL_MASK,
-			    aic31xx_divs[i].nadc ? aic31xx_divs[i].nadc : 1);
+			    div->nadc ? div->nadc : 1);
 	snd_soc_component_update_bits(component, AIC31XX_MADC, AIC31XX_PLL_MASK,
-			    aic31xx_divs[i].madc ? aic31xx_divs[i].madc : 1);
+			    div->madc ? div->madc : 1);
 
-	snd_soc_component_write(component, AIC31XX_AOSR, aic31xx_divs[i].aosr);
+	snd_soc_component_write(component, AIC31XX_AOSR, div->aosr);
 
 	/* Bit clock divider configuration. */
 	snd_soc_component_update_bits(component, AIC31XX_BCLKN,
@@ -945,15 +988,15 @@
 
 	dev_dbg(component->dev,
 		"pll %d.%04d/%d dosr %d n %d m %d aosr %d n %d m %d bclk_n %d\n",
-		aic31xx_divs[i].pll_j,
-		aic31xx_divs[i].pll_d,
+		div->pll_j,
+		div->pll_d,
 		aic31xx->p_div,
-		aic31xx_divs[i].dosr,
-		aic31xx_divs[i].ndac,
-		aic31xx_divs[i].mdac,
-		aic31xx_divs[i].aosr,
-		aic31xx_divs[i].nadc,
-		aic31xx_divs[i].madc,
+		div->dosr,
+		div->ndac,
+		div->mdac,
+		div->aosr,
+		div->nadc,
+		div->madc,
 		bclk_n
 	);
 
@@ -1180,7 +1223,8 @@
 	for (i = 0; i < ARRAY_SIZE(aic31xx_divs); i++)
 		if (aic31xx_divs[i].mclk_p == freq / aic31xx->p_div)
 			break;
-	if (i == ARRAY_SIZE(aic31xx_divs)) {
+	if (i == ARRAY_SIZE(aic31xx_divs) &&
+	    (freq / aic31xx->p_div < 10000000 || freq / aic31xx->p_div > 20000000)) {
 		dev_err(aic31xx->dev, "%s: Unsupported frequency %d\n",
 			__func__, freq);
 		return -EINVAL;
