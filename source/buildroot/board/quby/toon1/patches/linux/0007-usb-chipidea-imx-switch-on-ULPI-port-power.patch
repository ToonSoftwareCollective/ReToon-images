From: ReToon
Subject: [PATCH] usb: chipidea: imx: switch on the port power of a ULPI PHY

The external USB port of the Toon 1 (i.MX27) gets its 5 V from a switch
that the port's ULPI PHY controls (DrvVbus + DrvVbusExternal). With the
"retoon,ulpi-drive-vbus" property, set those bits once the pins are
handed over, as the board's original kernel did.
---
--- a/drivers/usb/chipidea/ci_hdrc_imx.c
+++ b/drivers/usb/chipidea/ci_hdrc_imx.c
@@ -16,6 +16,7 @@
 #include <linux/pinctrl/consumer.h>
 #include <linux/gpio/consumer.h>
 #include <linux/delay.h>
+#include <linux/iopoll.h>
 #include <linux/pm_qos.h>
 
 #include "ci.h"
@@ -345,6 +346,43 @@
 	regulator_disable(data->hsic_pad_regulator);
 }
 
+/*
+ * Toon 1: the PHY of the external USB port switches the port's 5 V through
+ * an external switch, with its DrvVbus and DrvVbusExternal bits (ULPI OTG
+ * control register 0x0a, "set" address 0x0b), as the board's original
+ * kernel did. Written through the controller's ULPI viewport.
+ */
+#define ULPI_VIEWPORT		0x170
+#define ULPI_VP_WAKEUP		BIT(31)
+#define ULPI_VP_RUN		BIT(30)
+#define ULPI_VP_WRITE		BIT(29)
+#define ULPI_OTG_CTRL_SET	0x0b
+#define ULPI_OTG_DRVVBUS	(BIT(5) | BIT(6))
+
+static void imx_ulpi_drive_vbus(struct platform_device *pdev)
+{
+	struct resource *res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	void __iomem *base;
+	u32 val;
+	int ret;
+
+	base = res ? ioremap(res->start, resource_size(res)) : NULL;
+	if (!base)
+		return;
+	writel(ULPI_VP_WAKEUP, base + ULPI_VIEWPORT);
+	ret = readl_poll_timeout(base + ULPI_VIEWPORT, val, !(val & ULPI_VP_WAKEUP), 1, 10000);
+	if (!ret) {
+		writel(ULPI_VP_RUN | ULPI_VP_WRITE | (ULPI_OTG_CTRL_SET << 16) | ULPI_OTG_DRVVBUS,
+		       base + ULPI_VIEWPORT);
+		ret = readl_poll_timeout(base + ULPI_VIEWPORT, val, !(val & ULPI_VP_RUN), 1, 10000);
+	}
+	iounmap(base);
+	if (ret)
+		dev_warn(&pdev->dev, "could not switch the port power on\n");
+	else
+		dev_info(&pdev->dev, "port power on\n");
+}
+
 static int ci_hdrc_imx_probe(struct platform_device *pdev)
 {
 	struct ci_hdrc_imx_data *data;
@@ -553,6 +591,8 @@
 					dev_warn(dev, "could not hand the ULPI pins over\n");
 				else
 					dev_info(dev, "ULPI pins handed over\n");
+				if (of_property_read_bool(np, "retoon,ulpi-drive-vbus"))
+					imx_ulpi_drive_vbus(pdev);
 			}
 		}
 	}
