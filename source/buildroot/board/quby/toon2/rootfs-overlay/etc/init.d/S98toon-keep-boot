#!/bin/sh
# The initrd removes boot.scr from p1 on every boot, so a boot that fails
# falls back to the original software at the next power cycle. Once this system is
# up and reachable (WiFi address + SSH server), put boot.scr back so the next
# boot comes here again. The master copy lives on p4 next to the root image.
# Only when "Always start ReToon" is on (config/autoboot, off by default):
# otherwise a restart goes back to the original software.
[ "$1" = start ] || exit 0
# U-Boot's start-up picture follows "Always start ReToon" too (in the
# background: making the picture takes a moment)
toon-bootsplash sync >/dev/null 2>&1 &

SRC=/mnt/data/toon-os/boot.scr
[ -f "$SRC" ] || exit 0
[ -e /mnt/data/toon-os/config/autoboot ] || exit 0

(
	# Without WiFi settings (first start, or after "factory defaults") the
	# Toon waits on its WiFi screen: keep waiting for as long as that takes.
	limit=60
	[ -s /mnt/data/toon-os/config/wpa_supplicant.conf ] || limit=1000000
	i=0
	while [ $i -lt $limit ]; do
		if ifconfig wlan0 2>/dev/null | grep -q 'inet addr' && pidof dropbear >/dev/null; then
			mkdir -p /mnt/boot
			if mount -t vfat /dev/mmcblk3p1 /mnt/boot 2>/dev/null; then
				cp "$SRC" /mnt/boot/boot.new && sync &&
					mv /mnt/boot/boot.new /mnt/boot/boot.scr &&
					logger -t toon-keep-boot "boot.scr restored, next boot starts this system"
				sync
				umount /mnt/boot
			fi
			exit 0
		fi
		sleep 5
		i=$((i + 1))
	done
	logger -t toon-keep-boot "not reachable after 5 minutes, next boot goes to the original software"
) &
