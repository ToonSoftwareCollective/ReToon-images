# Trim unneeded subsystems to shrink zImage size for milestone 1
# (display + wifi + ssh only, no camera/audio/NFS/bluetooth needed)
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_SOUND is not set
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CIFS is not set
# CONFIG_JFFS2_FS is not set
# CONFIG_UBIFS_FS is not set
# CONFIG_QUOTA is not set
# CONFIG_DRM_TI_TFP410 is not set
# CONFIG_DRM_PANEL_SEIKO_43WVF1G is not set

# WiFi: Broadcom/Cypress BCM43430 on SDIO (usdhc1) - milestone 1 needs this
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMUTIL=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_PROTO_BCDC=y
CONFIG_BRCMFMAC_SDIO=y

# Sensors / i2c peripherals (milestone: hardware layer)
CONFIG_HTS221=y
CONFIG_HTS221_I2C=y
CONFIG_RTC_DRV_ABX80X=y

# Ambient light (LTR303 handled by ltr501 driver) + ADC (vf610/imx6sx)
CONFIG_LTR501=y
CONFIG_VF610_ADC=y

# Bluetooth stack (Broadcom combo on UART3, H4) - kernel side
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_BCM=y

# Kill 60s user-helper firmware-load stalls for missing optional blobs
# CONFIG_FW_LOADER_USER_HELPER is not set

# Display: mainline DRM (LCDIF + fsl-ldb + panel-lvds); drop legacy fbdev mxsfb
CONFIG_DRM_MXSFB=y
CONFIG_DRM_FSL_LDB=y
# CONFIG_FB_MXS is not set

# Backlight: MP3309C (PWM dimming + i2c enable), see patches/linux/0002
CONFIG_BACKLIGHT_MP3309C_TOON=y

# Touch: Solomon SSD2543, see patches/linux/0003
CONFIG_TOUCHSCREEN_SSD2543_TOON=y

# Root filesystem as a compressed read-only image on p4 (loop + overlay)
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y

# Buzzer as a standard input sound device
CONFIG_INPUT_PWM_BEEPER=y
# GPU: the open etnaviv driver (Mesa) instead of NXP's galcore, which needs
# NXP's closed libraries that ReToon does not ship
CONFIG_DRM_ETNAVIV=y
# CONFIG_MXC_GPU_VIV is not set
# Bluetooth game pads and other BLE HID devices; PlayStation pad mapping
CONFIG_UHID=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_HID_PLAYSTATION=y
CONFIG_PLAYSTATION_FF=y
# rfkill: wpa_supplicant and bluetoothd look for it at start; also a clean way
# to switch WiFi or Bluetooth off in software
CONFIG_RFKILL=y
# USB sticks formatted as exFAT (the usual for sticks over 32 GB, and on
# Windows and Macs); FAT and usb-storage are already in
CONFIG_EXFAT_FS=y
